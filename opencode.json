{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "railway": {
      "type": "local",
      "command": ["sh", "/app/scripts/railway-mcp.sh"],
      "enabled": true,
      "codemode": false,
      "timeout": 30000
    }
  },
  "permission": {
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "browser": "allow",
    "package-manager": "allow",
    "database-query": "allow",
    "test-runner": "allow",
    "network-diagnostics": "allow",
    "system-diagnostics": "allow",
    "logs-observability": "allow",
    "image-inspect": "allow",
    "safe-download": "allow",
    "send-file": "allow",
    "railway": "allow",
    "external_directory": {
      "/data/logs/**": "allow"
    }
  }
}
