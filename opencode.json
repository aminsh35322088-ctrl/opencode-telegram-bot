{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "browser": "allow",
    "package-manager": "allow",
    "database-query": "allow",
    "test-runner": "allow",
    "session-recovery": "allow",
    "full-diagnostics": "allow",
    "network-diagnostics": "allow",
    "system-diagnostics": "allow",
    "logs-observability": "allow",
    "image-inspect": "allow",
    "safe-download": "allow",
    "send-file": "allow",
    "railway": "allow",
    "bash": {
      "*": "allow",
      "npx *": "deny",
      "npx": "deny",
      "npm ci *": "deny",
      "npm ci": "deny",
      "npm install *": "deny",
      "npm install": "deny",
      "npm i *": "deny",
      "npm i": "deny",
      "npm exec *": "deny",
      "pnpm install *": "deny",
      "pnpm install": "deny",
      "pnpm i *": "deny",
      "pnpm i": "deny",
      "pnpm dlx *": "deny",
      "yarn install *": "deny",
      "yarn install": "deny",
      "yarn dlx *": "deny",
      "bun install *": "deny",
      "bun install": "deny",
      "bunx *": "deny",
      "tsc *": "deny",
      "vitest *": "deny",
      "eslint *": "deny",
      "npm run test *": "deny",
      "npm run test": "deny",
      "npm run typecheck *": "deny",
      "npm run typecheck": "deny",
      "npm run lint *": "deny",
      "npm run lint": "deny",
      "npm run build *": "deny",
      "npm run build": "deny",
      "*/node_modules/.bin/tsc *": "deny",
      "*/node_modules/.bin/vitest *": "deny",
      "*/node_modules/.bin/eslint *": "deny",
      "*/node_modules/.bin/prettier *": "deny"
    },
    "external_directory": {
      "/data/logs/**": "allow"
    }
  }
}
