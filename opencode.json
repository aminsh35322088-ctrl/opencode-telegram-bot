{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "browser": "allow",
    "database-query": "allow",
    "session-recovery": "allow",
    "full-diagnostics": "allow",
    "network-diagnostics": "allow",
    "system-diagnostics": "allow",
    "logs-observability": "allow",
    "image-inspect": "allow",
    "safe-download": "allow",
    "send-file": "allow",
    "railway": "allow",
    "bash": {
      "*": "allow",
      "*npx*": "deny",
      "*corepack*": "deny",
      "*npm ci*": "deny",
      "*npm i *": "deny",
      "*npm install*": "deny",
      "*npm add*": "deny",
      "*npm uninstall*": "deny",
      "*npm remove*": "deny",
      "*npm update*": "deny",
      "*npm exec*": "deny",
      "*npm test*": "deny",
      "*npm run*test*": "deny",
      "*npm run*typecheck*": "deny",
      "*npm run*lint*": "deny",
      "*npm run*build*": "deny",
      "*npm run*dev*": "deny",
      "*pnpm install*": "deny",
      "*pnpm i *": "deny",
      "*pnpm add*": "deny",
      "*pnpm remove*": "deny",
      "*pnpm uninstall*": "deny",
      "*pnpm update*": "deny",
      "*pnpm dlx*": "deny",
      "*pnpm test*": "deny",
      "*pnpm run*test*": "deny",
      "*pnpm run*typecheck*": "deny",
      "*pnpm run*lint*": "deny",
      "*pnpm run*build*": "deny",
      "*pnpm run*dev*": "deny",
      "*yarn install*": "deny",
      "*yarn add*": "deny",
      "*yarn remove*": "deny",
      "*yarn uninstall*": "deny",
      "*yarn update*": "deny",
      "*yarn dlx*": "deny",
      "*yarn test*": "deny",
      "*yarn run*test*": "deny",
      "*yarn run*typecheck*": "deny",
      "*yarn run*lint*": "deny",
      "*yarn run*build*": "deny",
      "*yarn run*dev*": "deny",
      "*bun install*": "deny",
      "*bun i *": "deny",
      "*bun add*": "deny",
      "*bun remove*": "deny",
      "*bun uninstall*": "deny",
      "*bun update*": "deny",
      "*bunx*": "deny",
      "*bun test*": "deny",
      "*bun run*test*": "deny",
      "*bun run*typecheck*": "deny",
      "*bun run*lint*": "deny",
      "*bun run*build*": "deny",
      "*bun run*dev*": "deny",
      "*node_modules/.bin/*": "allow",
      "*vitest run*": "allow",
      "*tsc --noEmit*": "allow",
      "*eslint *": "allow",
      "*prettier *": "allow"
    },
    "external_directory": {
      "/data/logs/**": "allow"
    }
  }
}
