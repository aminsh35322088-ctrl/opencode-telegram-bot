{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "browser": "allow",
    "package-manager": "allow",
    "database-query": "allow",
    "test-runner": "allow",
    "session-recovery": "allow",
    "full-diagnostics": "allow",
    "network-diagnostics": "allow",
    "system-diagnostics": "allow",
    "logs-observability": "allow",
    "image-inspect": "allow",
    "safe-download": "allow",
    "send-file": "allow",
    "railway": "allow",
    "bash": {
      "*": "allow",
      "*npx*": "deny",
      "*npm ci*": "deny",
      "*npm install*": "deny",
      "*npm exec*": "deny",
      "*npm test*": "deny",
      "*npm run test*": "deny",
      "*npm run typecheck*": "deny",
      "*npm run lint*": "deny",
      "*npm run build*": "deny",
      "*pnpm install*": "deny",
      "*pnpm i *": "deny",
      "*pnpm dlx*": "deny",
      "*pnpm test*": "deny",
      "*pnpm run test*": "deny",
      "*pnpm run typecheck*": "deny",
      "*pnpm run lint*": "deny",
      "*pnpm run build*": "deny",
      "*yarn install*": "deny",
      "*yarn dlx*": "deny",
      "*yarn test*": "deny",
      "*yarn run test*": "deny",
      "*yarn run typecheck*": "deny",
      "*yarn run lint*": "deny",
      "*yarn run build*": "deny",
      "*bun install*": "deny",
      "*bunx*": "deny",
      "*bun test*": "deny",
      "*bun run test*": "deny",
      "*bun run typecheck*": "deny",
      "*bun run lint*": "deny",
      "*bun run build*": "deny",
      "*tsc *": "deny",
      "*vitest *": "deny",
      "*eslint *": "deny",
      "*prettier *": "deny",
      "*node_modules/.bin/tsc*": "deny",
      "*node_modules/.bin/vitest*": "deny",
      "*node_modules/.bin/eslint*": "deny",
      "*node_modules/.bin/prettier*": "deny"
    },
    "external_directory": {
      "/data/logs/**": "allow"
    }
  }
}
