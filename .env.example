# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=
# The single Telegram user ID allowed to use this bot
TELEGRAM_ALLOWED_USER_ID=

# Optional RustDesk agent bridge used by the OpenCode rustdesk tool.
# Loopback bridges may omit a token; remote bridge URLs require one.
# RUSTDESK_BRIDGE_URL=http://127.0.0.1:21119
# RUSTDESK_BRIDGE_TOKEN=
# RUSTDESK_BRIDGE_TIMEOUT_MS=30000
# RUSTDESK_MAX_TRANSFER_BYTES=8388608
