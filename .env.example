# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Allowed Telegram User IDs, comma-separated
TELEGRAM_ALLOWED_USER_ID=
# Optional GitHub Personal Access Token
# GITHUB_TOKEN=
# OpenCode API URL
# OPENCODE_API_URL=http://127.0.0.1:4096
# Railway-only OpenCode auto-start
# OPENCODE_AUTO_START_IN_CONTAINER=true
# OpenCode health monitor
# OPENCODE_AUTO_RESTART_ENABLED=true
# OPENCODE_MONITOR_INTERVAL_SEC=60
# OpenCode Server Authentication
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=
# OpenCode Model Configuration
OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=big-pickle
# Gemini image credentials are configured securely through /providers in Telegram.
# Do not put GEMINI_API_KEY in this file.
# Directory Browser Roots
# OPEN_BROWSER_ROOTS=/app/workspace
# Telegram Proxy URL
# TELEGRAM_PROXY_URL=
# Telegram Reverse Proxy
# TELEGRAM_API_ROOT=
# TELEGRAM_PROXY_SECRET=
# Force IPv4
# TELEGRAM_FORCE_IPV4=false
# Bot locale
# BOT_LOCALE=en
# Logging
# LOG_LEVEL=info
# Pagination limits
# SESSIONS_LIST_LIMIT=10
# MESSAGES_LIST_LIMIT=10
# PROJECTS_LIST_LIMIT=10
# COMMANDS_LIST_LIMIT=10
# MODELS_LIST_LIMIT=10
# Scheduled tasks
# TASK_LIMIT=10
# SCHEDULED_TASK_EXECUTION_TIMEOUT_MINUTES=120
# SCHEDULED_TASK_DISABLE_NOTIFICATION=false
# Maximum displayed bash command length
# BASH_TOOL_DISPLAY_MAX_LENGTH=128
# Background sessions
# TRACK_BACKGROUND_SESSIONS=true
# Assistant formatting
# MESSAGE_FORMAT_MODE=markdown
# Message merge window
# MESSAGE_MERGE_WINDOW_MS=1500
# Initial settings JSON
# INITIAL_SETTINGS_PRESET={"showAssistantRunFooter":false,"compactOutputMode":true}
# Maximum code file size in KB
# CODE_FILE_MAX_SIZE_KB=100
# Optional speech/document services
# STT_API_URL=
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=
# STT_REQUEST_FORMAT=multipart
# STT_NOTE_PROMPT=
# DOC_EXTRACTOR_URL=
# DOC_EXTRACTOR_API_KEY=
# Optional text-to-speech
# TTS_PROVIDER=openai
# TTS_API_URL=
# TTS_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
