# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=
# The single Telegram user ID allowed to use this bot
TELEGRAM_ALLOWED_USER_ID=

# Optional embedded Tailscale/tsnet SSH bridge (Railway-safe, no TUN required)
TSNET_ENABLED=false
TS_AUTHKEY=
TSNET_TARGET=
TSNET_TARGET_PORT=22
TSNET_LOCAL_ADDR=127.0.0.1:2222
TSNET_HOSTNAME=opencode-telegram-bot-railway
TSNET_EPHEMERAL=true
