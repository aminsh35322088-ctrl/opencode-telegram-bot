# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Allowed Telegram User IDs (from @userinfobot), comma-separated for multiple users
# Example: TELEGRAM_ALLOWED_USER_ID=123456789,987654321
TELEGRAM_ALLOWED_USER_ID=

# GitHub Personal Access Token for HTTPS git operations (optional).
# Recommended: a fine-grained token with access to the repositories you need.
# Use a classic PAT with `repo` only if you intentionally need access to all repositories.
# Never commit the token.
# GITHUB_TOKEN=

# OpenCode API URL. Railway uses the bundled local server on port 4096.
# OPENCODE_API_URL=http://127.0.0.1:4096

# Railway-only: allow the bot to start the bundled OpenCode server inside the container.
# Keep false/unset for the normal Docker deployment where OpenCode runs on the host.
# OPENCODE_AUTO_START_IN_CONTAINER=true

# Automatically restart a local OpenCode server when health-checks fail.
# OPENCODE_AUTO_RESTART_ENABLED=true

# OpenCode health monitor interval in seconds.
# Railway default: 60
# OPENCODE_MONITOR_INTERVAL_SEC=60

# OpenCode Server Authentication (optional)
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# OpenCode Model Configuration (required by the bot)
OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=big-pickle

# Google Gemini image generation/editing (optional)
# Nano Banana 2 / Gemini 3.1 Flash Image is the default image model.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Directory Browser Roots. Railway defaults to /app/workspace.
# OPEN_BROWSER_ROOTS=/app/workspace

# Telegram Proxy URL (optional)
# Supports socks5://, socks4://, http://, https:// protocols
# TELEGRAM_PROXY_URL=

# Telegram Reverse-Proxy mode (optional, alternative to TELEGRAM_PROXY_URL)
# TELEGRAM_API_ROOT=
# TELEGRAM_PROXY_SECRET=

# Force IPv4 for direct Telegram API/file requests (optional, default: false)
# TELEGRAM_FORCE_IPV4=false

# Bot locale: en, ar, de, es, fr, it, ko, pt, ru, zh
# BOT_LOCALE=en

# Logging level: debug, info, warn, error
# LOG_LEVEL=info

# Sessions per page
# SESSIONS_LIST_LIMIT=10

# Messages per page
# MESSAGES_LIST_LIMIT=10

# Projects per page
# PROJECTS_LIST_LIMIT=10

# Commands/skills per page
# COMMANDS_LIST_LIMIT=10

# Providers/models per page
# MODELS_LIST_LIMIT=10

# Scheduled task limit
# TASK_LIMIT=10

# Scheduled task execution timeout in minutes
# SCHEDULED_TASK_EXECUTION_TIMEOUT_MINUTES=120

# Disable push notifications for scheduled task results
# SCHEDULED_TASK_DISABLE_NOTIFICATION=false

# Maximum displayed bash command length
# BASH_TOOL_DISPLAY_MAX_LENGTH=128

# Track background sessions
# TRACK_BACKGROUND_SESSIONS=true

# Assistant message formatting: markdown or raw
# MESSAGE_FORMAT_MODE=markdown

# Merge near-limit Telegram message chunks
# MESSAGE_MERGE_WINDOW_MS=1500

# Optional initial settings JSON
# INITIAL_SETTINGS_PRESET={"showAssistantRunFooter":false,"compactOutputMode":true}

# Maximum code file size in KB
# CODE_FILE_MAX_SIZE_KB=100

# Optional speech/document services
# STT_API_URL=
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=
# STT_REQUEST_FORMAT=multipart
# STT_NOTE_PROMPT=
# DOC_EXTRACTOR_URL=
# DOC_EXTRACTOR_API_KEY=

# Optional text-to-speech
# TTS_PROVIDER=openai
# TTS_API_URL=
# TTS_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
